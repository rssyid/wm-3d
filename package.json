{
  "name": "wm-3d",
  "version": "0.1.0",
  "private": true,
  "description": "Simulasi 3D tata air kebun sawit di lahan gambut (curah hujan, TMAT, TMAS, pembuangan)",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.e2e.js\"",
    "check": "npm test && npm run test:e2e",
    "scenario": "node scripts/run-scenario.js"
  },
  "devDependencies": {
    "playwright-core": "1.56.1",
    "three": "0.185.1"
  },
  "license": "MIT"
}
